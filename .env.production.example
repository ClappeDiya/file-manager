# Production runtime env for marketing/ on the singularity VPS.
# Copy to .env.production (gitignored), fill in, and the deploy script will
# rsync it to /opt/filemanager/.env on the VPS so docker-compose can read it.

# Used by Next.js at runtime
NEXT_PUBLIC_SITE_URL=https://filemanager.clappe.com
NEXT_PUBLIC_GITHUB_REPO=ClappeDiya/file-manager

# Optional: forward /api/waitlist signups to Resend, Formspree, or your own
# webhook. Leave empty to no-op (the handler validates email then 200s).
WAITLIST_WEBHOOK_URL=

# Override image tag if doing manual rollback (defaults to "production")
# IMAGE_TAG=sha-04848b1
