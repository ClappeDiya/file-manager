{
  "name": "unified-file-ops",
  "version": "0.1.0",
  "private": true,
  "description": "Unified File Operations Platform - Cross-Platform File Manager, Transfer, Sync & Governance",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bash scripts/verify.sh",
    "verify:fast": "bash scripts/verify.sh --fast",
    "docs:ipc": "bash scripts/dump-ipc-commands.sh",
    "docs:ipc:check": "bash scripts/dump-ipc-commands.sh --check",
    "docs:ipc:verify": "bash scripts/dump-ipc-commands.sh --verify",
    "appstate:verify": "bash scripts/check-appstate.sh",
    "config:check": "bash scripts/check-tauri-config.sh",
    "migrations:check": "bash scripts/check-migrations.sh",
    "stores:check": "bash scripts/check-store-keys.sh",
    "connectors:check": "bash scripts/check-connectors.sh",
    "unwraps:check": "bash scripts/check-command-unwraps.sh",
    "toolbar:check": "bash scripts/check-toolbar-items.sh",
    "plugins:check": "bash scripts/check-tauri-plugins.sh",
    "pm:check": "bash scripts/check-package-manager.sh",
    "artifacts:check": "bash scripts/check-tracked-artifacts.sh",
    "version:check": "bash scripts/check-version-sync.sh",
    "tauri:versions": "bash scripts/check-tauri-versions.sh",
    "hygiene:check": "bash scripts/check-bash-hygiene.sh",
    "changelog:check": "bash scripts/check-changelog.sh",
    "gha:check": "bash scripts/check-github-actions.sh",
    "audit:check": "bash scripts/check-pnpm-audit.sh",
    "ws-deps:check": "bash scripts/check-workspace-deps.sh",
    "csp:check": "bash scripts/check-tauri-csp.sh",
    "stale-supp:check": "bash scripts/check-stale-suppressions.sh",
    "caps:check": "bash scripts/check-tauri-capabilities.sh",
    "cargo-audit:check": "bash scripts/check-cargo-audit.sh",
    "ret-types:check": "bash scripts/check-command-return-types.sh",
    "env-example:check": "bash scripts/check-env-example-drift.sh",
    "invoke-types:check": "bash scripts/check-tauri-invoke-types.sh",
    "hooks:install": "bash scripts/install-git-hooks.sh",
    "hooks:uninstall": "bash scripts/install-git-hooks.sh --uninstall",
    "hooks:status": "bash scripts/install-git-hooks.sh --status",
    "admin:dev": "pnpm --filter admin dev",
    "admin:build": "pnpm --filter admin build"
  },
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.22",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-aria": "^3.47.0",
    "react-aria-components": "^1.16.0",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^6.4.1",
    "vitest": "^4.1.0"
  }
}
