# UFOP Admin Console - Environment Variables
# Copy to .env.local and fill in values.

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ufop_admin

# NextAuth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3001

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin API (if connecting to external services)
ADMIN_API_URL=http://localhost:8080/api
ADMIN_API_KEY=
