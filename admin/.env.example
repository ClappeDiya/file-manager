# UFOP Admin Console - Environment Variables
# Copy to .env.local and fill in values.

# Database (PostgreSQL — Prisma/DBAL setup)
DATABASE_URL=postgresql://user:password@localhost:5432/ufop_admin

# SQLite data store (admin users, audit log, policy snapshots).
# Defaults to ./admin-data.db relative to the admin/ working directory.
ADMIN_DB_PATH=./admin-data.db

# NextAuth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3001

# Bootstrap admin user (auto-seeded on first run if no DB users exist).
# ADMIN_PASSWORD may be plaintext (will be bcrypt-hashed on seed) or a
# bcrypt hash starting with `$2a$` / `$2b$`. Leave ADMIN_PASSWORD empty
# to skip bootstrap seeding.
ADMIN_EMAIL=admin@ufop.local
ADMIN_PASSWORD=

# Key for secrets the console stores (alert channel passwords, webhook
# secrets, SSO client secrets): 32 random bytes, base64
# (`openssl rand -base64 32`). When empty, a key is derived from
# NEXTAUTH_SECRET; set this one so rotating NEXTAUTH_SECRET does not make
# stored secrets unreadable.
ADMIN_ENCRYPTION_KEY=

# The console's externally visible address when it runs behind a reverse
# proxy (used for links in emails, agent registration links, SSO callbacks
# and the SIEM host name). Empty: taken from the request.
ADMIN_PUBLIC_URL=

# Set to 1 to turn off the background jobs in this process (missed-backup
# alerts, summaries, retention, exports, outbox and SIEM delivery), e.g. on
# extra replicas behind a load balancer or in tests.
ADMIN_DISABLE_JOBS=

# Billing through Stripe (optional; without STRIPE_SECRET_KEY and
# STRIPE_WEBHOOK_SECRET licenses stay manual). Point a Stripe webhook at
# https://<console>/api/billing/webhook for checkout.session.completed,
# customer.subscription.created|updated|deleted|trial_will_end,
# customer.updated (tells the console a card was added or removed in the
# billing portal; without it the trial notices say "check the billing
# portal" instead of knowing whether a card is on file) and
# invoice.paid|payment_failed. Create the endpoint with API version
# 2024-06-20 (the version the console's own calls use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-seat Stripe price ids of the Business plan: monthly, and (optional)
# yearly. Without the yearly one the billing page offers monthly only.
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=
# Override of the Stripe API address (tests, proxies).
STRIPE_API_BASE=
# Free trial of an organization's first subscription, in days (no card needed
# to start). Default 14, as the marketing pricing page says; 0 turns trials off.
BILLING_TRIAL_DAYS=14
# Show the promotion-code field on Stripe Checkout. Default on; 0 / false hides it.
BILLING_ALLOW_PROMOTION_CODES=1

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin API (if connecting to external services)
ADMIN_API_URL=http://localhost:8080/api
ADMIN_API_KEY=

# Client-visible env (exposed to the browser bundle — never put secrets here)
NEXT_PUBLIC_APP_NAME=UFOP Admin Console
NEXT_PUBLIC_API_URL=
