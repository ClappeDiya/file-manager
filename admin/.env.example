# UFOP Admin Console - Environment Variables
# Copy to .env.local and fill in values.

# Database (PostgreSQL — Prisma/DBAL setup)
DATABASE_URL=postgresql://user:password@localhost:5432/ufop_admin

# SQLite data store (admin users, audit log, policy snapshots).
# Defaults to ./admin-data.db relative to the admin/ working directory.
ADMIN_DB_PATH=./admin-data.db

# NextAuth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3001

# Bootstrap admin user (auto-seeded on first run if no DB users exist).
# ADMIN_PASSWORD may be plaintext (will be bcrypt-hashed on seed) or a
# bcrypt hash starting with `$2a$` / `$2b$`. Leave ADMIN_PASSWORD empty
# to skip bootstrap seeding.
ADMIN_EMAIL=admin@ufop.local
ADMIN_PASSWORD=

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin API (if connecting to external services)
ADMIN_API_URL=http://localhost:8080/api
ADMIN_API_KEY=

# Client-visible env (exposed to the browser bundle — never put secrets here)
NEXT_PUBLIC_APP_NAME=UFOP Admin Console
NEXT_PUBLIC_API_URL=
