ADMIN_DOMAIN=app.filemanager.clappe.com
ADMIN_PUBLIC_URL=https://app.filemanager.clappe.com
ADMIN_EMAIL=
# Set only for the first empty-database bootstrap. Remove it after the owner exists.
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
# Exactly 32 random bytes encoded as base64; preserve with the database backup.
ADMIN_ENCRYPTION_KEY=
CONNECTORS_ALLOW_PRIVATE=0
# Replace with the immutable full commit SHA tag published after local CI.
IMAGE_TAG=
