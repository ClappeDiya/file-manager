# UFOP Admin Console - Environment Variables
# Copy to .env.local and fill in values.

# ── Authentication (REQUIRED) ──
# Admin login credentials
ADMIN_EMAIL=admin@ufop.local
ADMIN_PASSWORD=changeme

# JWT signing secret (REQUIRED — generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# ── Database ──
# SQLite database path (default: .data/admin.db)
# ADMIN_DB_PATH=.data/admin.db

# ── Email / SMTP (optional — enables email password reset) ──
# If not set, only recovery codes are available for password reset
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# ── OAuth Providers (optional) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
