# Unified File Operations Platform - Environment Variables
# Copy this file to .env and fill in values before running.

# ──────────────────────────────────────────────
# Desktop App (Tauri)
# ──────────────────────────────────────────────

# Tauri updater public key (required for auto-update verification)
# Generate with: tauri signer generate -w ~/.tauri/ufop.key
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Optional dev-server bind host. Set to a LAN IP (e.g. 192.168.1.20)
# when running `tauri:dev` against a device on the same network. Leave
# unset (or empty) to bind to localhost only, which is the safe default.
TAURI_DEV_HOST=

# ──────────────────────────────────────────────
# Admin Console (Next.js)
# ──────────────────────────────────────────────

# Database URL for admin console (PostgreSQL recommended)
DATABASE_URL=postgresql://user:password@localhost:5432/ufop_admin

# NextAuth.js secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# OAuth providers (optional, for admin SSO)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ──────────────────────────────────────────────
# Cloud Provider OAuth (Desktop App)
# ──────────────────────────────────────────────

# Google Drive API credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Dropbox API credentials
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# OneDrive / Microsoft Graph API credentials
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# AWS (Desktop App - optional, can also use ~/.aws/credentials)
# ──────────────────────────────────────────────

# AWS credentials (if not using AWS CLI credential chain)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ──────────────────────────────────────────────
# Feature Flags
# ──────────────────────────────────────────────

# Enable AI assistant features (requires API key)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=

# Enable telemetry (opt-in only)
TELEMETRY_ENABLED=false
